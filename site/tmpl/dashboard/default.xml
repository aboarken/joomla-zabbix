<?xml version="1.0" encoding="UTF-8"?>
<metadata>
    <layout title="COM_ZABBIX_MENU_DASHBOARD">
        <message><![CDATA[COM_ZABBIX_MENU_DASHBOARD_DESC]]></message>
    </layout>
    <fields name="params">
        <fieldset name="basic" label="COM_ZABBIX_MENU_FIELDSET_DASHBOARD"
                  addfieldprefix="ZabbixPortal\Component\Zabbix\Administrator\Field">
            <field name="dashboard_id" type="zabbixdashboard" label="COM_ZABBIX_MENU_DASHBOARD_ID"
                   description="COM_ZABBIX_MENU_DASHBOARD_ID_DESC" default="" filter="integer">
                <option value="">COM_ZABBIX_MENU_DASHBOARD_FIRST</option>
            </field>
            <field name="allow_choose" type="radio" label="COM_ZABBIX_MENU_ALLOW_CHOOSE"
                   description="COM_ZABBIX_MENU_ALLOW_CHOOSE_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field name="refresh" type="list" label="COM_ZABBIX_MENU_REFRESH" description="COM_ZABBIX_MENU_REFRESH_DESC" default="" validate="options">
                <option value="">COM_ZABBIX_MENU_REFRESH_DEFAULT</option>
                <option value="0">COM_ZABBIX_SETTINGS_REFRESH_OFF</option>
                <option value="30">COM_ZABBIX_SETTINGS_REFRESH_30S</option>
                <option value="60">COM_ZABBIX_SETTINGS_REFRESH_1M</option>
                <option value="120">COM_ZABBIX_SETTINGS_REFRESH_2M</option>
                <option value="300">COM_ZABBIX_SETTINGS_REFRESH_5M</option>
                <option value="600">COM_ZABBIX_SETTINGS_REFRESH_10M</option>
                <option value="900">COM_ZABBIX_SETTINGS_REFRESH_15M</option>
            </field>
        </fieldset>
    </fields>
</metadata>
