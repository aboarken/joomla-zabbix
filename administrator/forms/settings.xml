<?xml version="1.0" encoding="UTF-8"?>
<!--
    Integration Settings. Values are validated and stored by SettingsValidator /
    IntegrationsettingsModel (not by com_config); the API token is encrypted first.
-->
<form>
    <fieldset name="connection" label="COM_ZABBIX_SETTINGS_FIELDSET_CONNECTION">
        <field name="zabbix_url" type="url" label="COM_ZABBIX_SETTINGS_URL" description="COM_ZABBIX_SETTINGS_URL_DESC"
               hint="https://zabbix.example.org" filter="string" size="60" maxlength="300" validate="url" schemes="http,https" />
        <field name="api_token" type="password" label="COM_ZABBIX_SETTINGS_TOKEN" description="COM_ZABBIX_SETTINGS_TOKEN_DESC"
               autocomplete="new-password" filter="unset" lock="false" maxlength="128" />
        <field name="clear_api_token" type="checkbox" label="COM_ZABBIX_SETTINGS_CLEAR_TOKEN" description="COM_ZABBIX_SETTINGS_CLEAR_TOKEN_DESC"
               value="1" filter="unset" />
        <field name="verify_tls" type="radio" label="COM_ZABBIX_SETTINGS_VERIFY_TLS" description="COM_ZABBIX_SETTINGS_VERIFY_TLS_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="ca_bundle" type="text" label="COM_ZABBIX_SETTINGS_CA" description="COM_ZABBIX_SETTINGS_CA_DESC"
               filter="path" size="60" showon="verify_tls:1" />
        <field name="connect_timeout" type="number" label="COM_ZABBIX_SETTINGS_CONNECT_TIMEOUT" description="COM_ZABBIX_SETTINGS_CONNECT_TIMEOUT_DESC"
               default="5" min="1" max="30" filter="integer" required="true" />
        <field name="timeout" type="number" label="COM_ZABBIX_SETTINGS_TIMEOUT" description="COM_ZABBIX_SETTINGS_TIMEOUT_DESC"
               default="20" min="1" max="120" filter="integer" required="true" />
        <field name="show_links" type="radio" label="COM_ZABBIX_SETTINGS_SHOW_LINKS" description="COM_ZABBIX_SETTINGS_SHOW_LINKS_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="frontend_url" type="url" label="COM_ZABBIX_SETTINGS_FRONTEND_URL" description="COM_ZABBIX_SETTINGS_FRONTEND_URL_DESC"
               hint="https://zabbix.example.org" filter="string" size="60" maxlength="300" showon="show_links:1" />
    </fieldset>

    <fieldset name="mapping" label="COM_ZABBIX_SETTINGS_FIELDSET_MAPPING">
        <field name="auto_match" type="radio" label="COM_ZABBIX_SETTINGS_AUTO_MATCH" description="COM_ZABBIX_SETTINGS_AUTO_MATCH_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="match_mode" type="list" label="COM_ZABBIX_SETTINGS_MATCH_MODE" description="COM_ZABBIX_SETTINGS_MATCH_MODE_DESC"
               default="username_email" validate="options">
            <option value="username_email">COM_ZABBIX_SETTINGS_MATCH_USERNAME_EMAIL</option>
            <option value="username">COM_ZABBIX_SETTINGS_MATCH_USERNAME</option>
            <option value="email">COM_ZABBIX_SETTINGS_MATCH_EMAIL</option>
        </field>
    </fieldset>

    <fieldset name="portal" label="COM_ZABBIX_SETTINGS_FIELDSET_PORTAL">
        <field name="refresh_seconds" type="list" label="COM_ZABBIX_SETTINGS_REFRESH" description="COM_ZABBIX_SETTINGS_REFRESH_DESC"
               default="60" validate="options">
            <option value="0">COM_ZABBIX_SETTINGS_REFRESH_OFF</option>
            <option value="30">COM_ZABBIX_SETTINGS_REFRESH_30S</option>
            <option value="60">COM_ZABBIX_SETTINGS_REFRESH_1M</option>
            <option value="120">COM_ZABBIX_SETTINGS_REFRESH_2M</option>
            <option value="300">COM_ZABBIX_SETTINGS_REFRESH_5M</option>
            <option value="600">COM_ZABBIX_SETTINGS_REFRESH_10M</option>
            <option value="900">COM_ZABBIX_SETTINGS_REFRESH_15M</option>
        </field>
        <field name="max_hosts" type="number" label="COM_ZABBIX_SETTINGS_MAX_HOSTS" description="COM_ZABBIX_SETTINGS_MAX_HOSTS_DESC"
               default="2000" min="10" max="20000" filter="integer" required="true" />
    </fieldset>

    <fieldset name="system" label="COM_ZABBIX_SETTINGS_FIELDSET_SYSTEM">
        <field name="detailed_log" type="radio" label="COM_ZABBIX_SETTINGS_DETAILED_LOG" description="COM_ZABBIX_SETTINGS_DETAILED_LOG_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="cache_minutes" type="number" label="COM_ZABBIX_SETTINGS_CACHE_MINUTES" description="COM_ZABBIX_SETTINGS_CACHE_MINUTES_DESC"
               default="2" min="0" max="60" filter="integer" required="true" />
        <field name="date_format" type="list" label="COM_ZABBIX_SETTINGS_DATE_FORMAT" description="COM_ZABBIX_SETTINGS_DATE_FORMAT_DESC" default="d/m/Y" validate="options">
            <option value="d/m/Y">05/11/2026</option>
            <option value="Y-m-d">2026-11-05</option>
            <option value="m/d/Y">11/05/2026</option>
            <option value="d.m.Y">05.11.2026</option>
            <option value="d M Y">05 Nov 2026</option>
        </field>
        <field name="time_format" type="list" label="COM_ZABBIX_SETTINGS_TIME_FORMAT" description="COM_ZABBIX_SETTINGS_TIME_FORMAT_DESC" default="H:i" validate="options">
            <option value="H:i">14:05</option>
            <option value="H:i:s">14:05:09</option>
            <option value="h:i A">02:05 PM</option>
        </field>
        <field name="display_timezone" type="timezone" label="COM_ZABBIX_SETTINGS_TIMEZONE" description="COM_ZABBIX_SETTINGS_TIMEZONE_DESC">
            <option value="">COM_ZABBIX_SETTINGS_TIMEZONE_JOOMLA</option>
        </field>
    </fieldset>
</form>
